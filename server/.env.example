# Copy this file to server/.env and fill values. Never commit .env.

NODE_ENV=development
PORT=4242

# Stripe TEST MODE keys from the client's Stripe Dashboard → Developers.
# Use sk_test_ / pk_test_ / whsec_ until go-live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ADULT=
STRIPE_PRICE_CHILD=
# Monthly membership tiers (brochure): Essential $149 / Elevated $199 / Signature $299
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_ELEVATED=
STRIPE_PRICE_SIGNATURE=

PUBLIC_SITE_URL=https://foundationalaestheticwellness.com
ALLOWED_ORIGINS=https://foundationalaestheticwellness.com,https://www.foundationalaestheticwellness.com,http://localhost:4242,http://127.0.0.1:4242,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Optional WhatsApp Cloud API (Meta). If empty, Confirm opens a WhatsApp chat link for staff to send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY=1

# Required before production. Random 32+ character string.
SESSION_SECRET=

# Staff admin at /admin
# ADMIN_PASSWORD is used only to seed the first admin hash into the database.
# After first boot / password change, the live password is the DB hash (not rewritten to .env).
# Use a strong password (12+ characters).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional job trigger: POST /internal/jobs/renewal-reminders with header X-Cron-Secret
CRON_SECRET=

# Patient matching. local = SQLite match on last name + DOB + phone (and optional chart ID).
# http = call PATIENT_API_URL/patients/match with Bearer PATIENT_API_KEY.
PATIENT_ADAPTER=local
PATIENT_API_URL=
PATIENT_API_KEY=
